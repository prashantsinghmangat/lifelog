<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's foreground layer. The same geometry as public/logo.svg,
  authored on that file's 24-unit grid and scaled into the central third of the
  108dp canvas, which is the only part of an adaptive icon guaranteed not to be
  cropped by whatever mask the launcher applies.

  Group transforms apply as scale then translate, so a point p lands at p*3+18:
  the mark occupies 32..78 of 108, comfortably inside the 18..90 safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3"
        android:scaleY="3"
        android:translateX="18"
        android:translateY="18">

        <!-- The spine. Square ends, because the end nodes sit over them. -->
        <path
            android:fillColor="#E8EAF0"
            android:pathData="M6.2,5 H7.8 V19 H6.2 Z" />

        <path
            android:fillColor="#FF8F7A"
            android:pathData="M4.8,7 A2.2,2.2 0 1 0 9.2,7 A2.2,2.2 0 1 0 4.8,7 Z" />
        <path
            android:fillColor="#E8EAF0"
            android:pathData="M12,6 L18,6 A1,1 0 0 1 18,8 L12,8 A1,1 0 0 1 12,6 Z" />

        <path
            android:fillColor="#3EC5B9"
            android:pathData="M4.8,12 A2.2,2.2 0 1 0 9.2,12 A2.2,2.2 0 1 0 4.8,12 Z" />
        <path
            android:fillColor="#E8EAF0"
            android:pathData="M12,11 L15.5,11 A1,1 0 0 1 15.5,13 L12,13 A1,1 0 0 1 12,11 Z" />

        <path
            android:fillColor="#A78BFA"
            android:pathData="M4.8,17 A2.2,2.2 0 1 0 9.2,17 A2.2,2.2 0 1 0 4.8,17 Z" />
        <path
            android:fillColor="#E8EAF0"
            android:pathData="M12,16 L19,16 A1,1 0 0 1 19,18 L12,18 A1,1 0 0 1 12,16 Z" />
    </group>
</vector>
